{
  "private": true,
  "scripts": {
    "docker:config": "docker compose --env-file supabase/docker/.env -f supabase/docker/docker-compose.yml config",
    "docker:pull": "docker compose --env-file supabase/docker/.env -f supabase/docker/docker-compose.yml pull",
    "docker:start": "docker compose --env-file supabase/docker/.env -f supabase/docker/docker-compose.yml up -d",
    "docker:stop": "docker compose --env-file supabase/docker/.env -f supabase/docker/docker-compose.yml down",
    "docker:status": "docker compose --env-file supabase/docker/.env -f supabase/docker/docker-compose.yml ps",
    "test:iam-edge": "node --experimental-strip-types --test supabase/tests/functions/iam-admin_handler_test.ts",
    "test:iam-http": "node supabase/tests/integration/iam-admin-http.mjs",
    "test:sprint01-http": "node supabase/tests/integration/sprint-01-topics-http.mjs",
    "test:sprint03-http": "node supabase/tests/integration/sprint-03-session-voting-http.mjs",
    "test:sprint035-http": "node supabase/tests/integration/sprint-03-5-governance-http.mjs",
    "test:sprint036-http": "node supabase/tests/integration/sprint-03-6-councils-http.mjs",
    "test:compatibility": "node supabase/tests/compatibility-surface-check.mjs",
    "docs:api-contracts": "node supabase/tests/api-documentation-contract-check.mjs --write",
    "test:api-docs": "node supabase/tests/api-documentation-contract-check.mjs",
    "build:legal-source-catalog": "node scripts/build-legal-source-catalog.mjs",
    "build:regulation-bundles": "node scripts/build-binary-regulation-bundles.mjs",
    "validate:regulation-bundles": "node scripts/validate-binary-regulation-bundles.mjs",
    "import:regulation-bundles": "node scripts/import-binary-regulation-bundles.mjs",
    "replace:local-regulations": "python scripts/replace-local-regulations.py --confirm-local-replace",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "supabase": "^2.109.1"
  }
}
