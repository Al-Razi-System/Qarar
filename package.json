    "test:sprint03-http": "node supabase/tests/integration/sprint-03-session-voting-http.mjs",
    "test:sprint035-http": "node supabase/tests/integration/sprint-03-5-governance-http.mjs",
    "seed:regulations-demo": "node supabase/tests/integration/sprint-03-5-governance-http.mjs --keep-fixtures",
