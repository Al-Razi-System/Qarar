    "docker:stop": "docker compose --env-file supabase/docker/.env -f supabase/docker/docker-compose.yml down",
    "docker:status": "docker compose --env-file supabase/docker/.env -f supabase/docker/docker-compose.yml ps",
    "test:iam-edge": "node --experimental-strip-types --test supabase/tests/functions/iam-admin_handler_test.ts",
