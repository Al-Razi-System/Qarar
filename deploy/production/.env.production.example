# Copy to an encrypted secret store. Never commit the populated file.
NODE_ENV=production
APP_ORIGIN=https://admin.example.gov
SUPABASE_PUBLIC_URL=https://api.example.gov
# Canonical public GoTrue issuer/endpoint. Keep the exact HTTPS /auth/v1 path
# (no trailing slash, query, fragment, credentials, wildcard, or default-port alias).
API_EXTERNAL_URL=https://api.example.gov/auth/v1
# SITE_URL is intentionally byte-for-byte identical to APP_ORIGIN.
SITE_URL=https://admin.example.gov
# Comma-separated canonical HTTPS redirect URLs only. Every entry must have an
# origin in ALLOWED_ORIGINS, contain no wildcard/credentials/query/fragment,
# and this list must include the exact APP_ORIGIN/auth/callback endpoint.
ADDITIONAL_REDIRECT_URLS=https://admin.example.gov/auth/callback,https://admin.example.gov/auth/recovery
ALLOWED_ORIGINS=https://admin.example.gov

# Base Supabase topology. These are intentionally explicit so Compose never
# substitutes an empty string in a production configuration.
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
KONG_HTTP_PORT=54321
KONG_HTTPS_PORT=54326
DASHBOARD_USERNAME=supabase
PGRST_DB_SCHEMAS=api_v1,public,graphql_public
STUDIO_DEFAULT_ORGANIZATION=Qarar
STUDIO_DEFAULT_PROJECT=Qarar Production
POOLER_DB_POOL_SIZE=5
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=qarar-production
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GLOBAL_S3_BUCKET=qarar-production
REGION=REPLACE_WITH_DEPLOYMENT_REGION
STORAGE_TENANT_ID=qarar-production
IMGPROXY_AUTO_WEBP=true
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Define optional upstream integration keys explicitly (blank disables them)
# so Docker Compose does not silently substitute a missing value.
OPENAI_API_KEY=
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
QARAR_ACTIVATION_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
QARAR_SSO_ENABLED=false
QARAR_BACKUP_OFFSITE_BUCKET=REPLACE_WITH_SEPARATE_ACCOUNT_IMMUTABLE_BUCKET
QARAR_BACKUP_OFFSITE_PREFIX=qarar-production
QARAR_BACKUP_KMS_KEY_ID=arn:aws:kms:REGION:ACCOUNT:key/REPLACE_WITH_KEY_ID
QARAR_BACKUP_RETENTION_DAYS=365
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Generate every value independently with a cryptographically secure generator.
POSTGRES_PASSWORD=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
JWT_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
ANON_KEY=REPLACE_WITH_GENERATED_ANON_JWT
SERVICE_ROLE_KEY=REPLACE_WITH_GENERATED_SERVICE_ROLE_JWT
DASHBOARD_PASSWORD=REPLACE_WITH_20_PLUS_RANDOM_CHARACTERS
SECRET_KEY_BASE=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
VAULT_ENC_KEY=REPLACE_WITH_EXACTLY_32_CHARACTERS
PG_META_CRYPTO_KEY=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
REALTIME_DB_ENC_KEY=REPLACE_WITH_EXACTLY_16_CHARACTERS
LOGFLARE_PUBLIC_ACCESS_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
LOGFLARE_PRIVATE_ACCESS_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
S3_PROTOCOL_ACCESS_KEY_ID=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
S3_PROTOCOL_ACCESS_KEY_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
METRICS_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
QARAR_METRICS_TOKEN_FILE=./.runtime/metrics-token
QARAR_ALERT_WEBHOOK_URL=https://alerts.example.gov/qarar
QARAR_ALERT_WEBHOOK_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
# Render this secret-bearing file outside the repository with
# `npm run prod:render-monitoring`; mount only the rendered result.
QARAR_ALERTMANAGER_CONFIG_PATH=./.runtime/alertmanager.yml
QARAR_LOGIN_RATE_LIMIT_REDIS_HOST=login-rate-limit-redis
QARAR_LOGIN_RATE_LIMIT_REDIS_PORT=6379
QARAR_LOGIN_RATE_LIMIT_REDIS_PASSWORD=REPLACE_WITH_32_PLUS_BASE64URL_RANDOM_CHARACTERS
QARAR_LOGIN_RATE_LIMIT_HMAC_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
QARAR_LOGIN_RATE_LIMIT_CLIENT_IP_HEADER=x-qarar-client-ip
QARAR_LOGIN_RATE_LIMIT_EMAIL_MAX_ATTEMPTS=5
QARAR_LOGIN_RATE_LIMIT_CLIENT_MAX_ATTEMPTS=20
QARAR_LOGIN_RATE_LIMIT_GLOBAL_MAX_ATTEMPTS=300
QARAR_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
QARAR_LOGIN_RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
# Uploads are scanned through an internal ClamAV sidecar before storage. This
# is deliberately a service name, not a configurable remote scanner URL.
QARAR_UPLOAD_SCAN_REQUIRED=true
QARAR_UPLOAD_SCAN_ADAPTER=clamav-internal
QARAR_UPLOAD_SCAN_HOST=clamav
QARAR_UPLOAD_SCAN_PORT=3310
QARAR_UPLOAD_SCAN_TIMEOUT_MS=10000
QARAR_UPLOAD_SCAN_MAX_BYTES=26214400

DISABLE_SIGNUP=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_EMAIL_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
FUNCTIONS_VERIFY_JWT=true
# Defense in depth: this must remain false and production Compose forces it.
QARAR_APPLY_SEED=false
# Notification delivery is a required production dependency. The generic
# webhook receiver must deduplicate on event_id or deduplication_key.
QARAR_OUTBOX_DISPATCHER_ENABLED=true
QARAR_OUTBOX_REQUIRED=true
QARAR_OUTBOX_WEBHOOK_URL=https://notifications.example.gov/qarar/events
QARAR_OUTBOX_WEBHOOK_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
QARAR_OUTBOX_DISPATCH_INTERVAL_MS=5000
QARAR_OUTBOX_WEBHOOK_TIMEOUT_MS=10000
QARAR_OUTBOX_BATCH_SIZE=25
QARAR_OUTBOX_LEASE_SECONDS=600
JWT_EXPIRY=3600
SMTP_HOST=smtp.example.gov
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_SECRET
SMTP_ADMIN_EMAIL=no-reply@example.gov
SMTP_SENDER_NAME=Qarar
