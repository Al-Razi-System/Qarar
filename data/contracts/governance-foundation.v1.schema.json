{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qarar.local/contracts/governance-foundation.v1.schema.json",
  "title": "Qarar governance foundation contract",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "authority_review",
    "topic_workflows",
    "operational_policies",
    "blocked_records"
  ],
  "properties": {
    "schema_version": { "const": "qarar.governance_foundation.v1" },
    "source": {
      "type": "object",
      "required": ["file_name", "sha256", "reviewed_on"],
      "properties": {
        "file_name": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reviewed_on": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "authority_review": {
      "type": "object",
      "required": ["accepted_status", "accepted_topic_ids", "activation_allowed"],
      "properties": {
        "accepted_status": { "const": "accepted_as_authority_source" },
        "accepted_topic_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(TOP|NEW)-[0-9]{4}$" }
        },
        "activation_allowed": { "const": false }
      },
      "additionalProperties": false
    },
    "topic_workflows": {
      "type": "array",
      "items": { "$ref": "#/$defs/topicWorkflow" }
    },
    "operational_policies": {
      "type": "array",
      "items": { "$ref": "#/$defs/operationalPolicy" }
    },
    "blocked_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/blockedRecord" }
    }
  },
  "$defs": {
    "topicWorkflow": {
      "type": "object",
      "required": ["workflow_code", "status", "source_step_ids", "missing_requirements"],
      "properties": {
        "workflow_code": { "type": "string", "pattern": "^WFL-[A-Z0-9-]+$" },
        "status": { "enum": ["draft_model_ready", "blocked"] },
        "source_step_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^R-[A-Z0-9-]+$" }
        },
        "topic_type_code": { "type": ["string", "null"] },
        "missing_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["topic_type_code", "step_authority_id", "outcome_transitions"] }
        }
      },
      "additionalProperties": false
    },
    "operationalPolicy": {
      "type": "object",
      "required": ["policy_code", "policy_kind", "source_step_ids", "status"],
      "properties": {
        "policy_code": { "type": "string", "pattern": "^WFL-[A-Z0-9-]+$" },
        "policy_kind": { "enum": ["recurrence", "minutes_review", "objection", "execution"] },
        "source_step_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^R-[A-Z0-9-]+$" }
        },
        "status": { "const": "draft_model_ready" }
      },
      "additionalProperties": false
    },
    "blockedRecord": {
      "type": "object",
      "required": ["record_id", "record_kind", "reason_code", "source_location"],
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "record_kind": { "enum": ["authority", "workflow_step"] },
        "reason_code": {
          "enum": [
            "missing_clause",
            "duplicate_topic_requires_merge",
            "missing_authority_link",
            "missing_topic_type_binding",
            "missing_outcome_transitions"
          ]
        },
        "source_location": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
